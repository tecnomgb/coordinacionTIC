#DETECTAR SE O DISCO DURO RAÍZ É SSD OU EMMC E ESTABLECER UN TRIM NEL EN TAL CASO
ROOT_PARTITION=$(df -P / | awk 'NR==2 {print $1}')
# Usamos 'echo' e 'sed' para extraer o nome do disco base (sda, mmcblk0, nvme0n1)
if echo "$ROOT_PARTITION" | grep -q '/dev/mmcblk'; then
    # Se é eMMC, o nome do disco é 'mmcblk0' (eliminamos 'p1' ou o que sexa)
    PRIMARY_DISK=$(echo "$ROOT_PARTITION" | sed 's/[0-9]*$//' | sed 's/\/dev\///')
elif echo "$ROOT_PARTITION" | grep -q '/dev/nvme'; then
    # Se é NVMe, o nome do disco é 'nvme0n1' (eliminamos 'p1' ou o que sexa)
    PRIMARY_DISK=$(echo "$ROOT_PARTITION" | sed 's/p[0-9]*$//' | sed 's/\/dev\///')
else
    # Para discos tradicionais (sda, sdb), o nome é 'sda' (eliminamos '1', '2', etc.)
    PRIMARY_DISK=$(echo "$ROOT_PARTITION" | sed 's/[0-9]*$//' | sed 's/\/dev\///')
fi
# 2. Executar blkid e gardar a saída para a comprobación (non se usa neste script, pero mantense por consistencia)
sudo blkid > /tmp/particions
# 3. Lóxica de identificación e configuración do TRIM
# Comprobación A: É eMMC? (O nome do disco contén 'mmcblk')
# Usamos 'echo' e 'grep -q' (quiet) para emular o [[ ... == *patrón* ]] de Bash
if echo "$PRIMARY_DISK" | grep -q 'mmcblk';
then
    echo "O disco SSD é tipo eMMC ($PRIMARY_DISK)";
    # Procedemos directamente á configuración do TRIM (Bloque D)
    # Bloque D: Configuración do TRIM
    # Usamos 'grep -c' en lugar de 'egrep -c'
    if [ -f /etc/systemd/system/fstrim.timer.d/override.conf ] && [ "$(grep -c 'daily' /etc/systemd/system/fstrim.timer.d/override.conf)" = '1' ];
        then
            echo "Disco SSD con TRIM xa programado diariamente";
        else
            sudo mkdir -p /etc/systemd/system/fstrim.timer.d;
            sudo rm -f /etc/systemd/system/fstrim.timer.d/override.conf;
            sudo touch /etc/systemd/system/fstrim.timer.d/override.conf;
            
            # NOTA: En SH non podemos usar múltiples 'echo' nunha liña con 'tee'.
            # Usamos un bloque de código para facelo máis limpo.
            (
                echo "[Timer]"
                echo "OnCalendar="
                echo "OnCalendar=daily"
            ) | sudo tee /etc/systemd/system/fstrim.timer.d/override.conf;
            
            sudo chmod 755 /etc/systemd/system/fstrim.timer.d/override.conf;
            echo "Configuración de TRIM diario aplicada."
    fi
else
    # Non é eMMC. Comprobación B: É HDD ou SSD tradicional/NVMe?
    # Comprobamos se o disco é rotacional usando o nome do disco atopado
    if [ "$(cat "/sys/block/$PRIMARY_DISK/queue/rotational")" = '1' ];
        then
            echo "O disco duro principal é tipo HDD ($PRIMARY_DISK)";
        else
            # É un SSD estándar ou NVMe
            
            # Bloque D: Configuración do TRIM
            if [ -f /etc/systemd/system/fstrim.timer.d/override.conf ] && [ "$(grep -c 'daily' /etc/systemd/system/fstrim.timer.d/override.conf)" = '1' ];
                then
                    echo "Disco SSD con TRIM xa programado diariamente";
                else
                    sudo mkdir -p /etc/systemd/system/fstrim.timer.d;
                    sudo rm -f /etc/systemd/system/fstrim.timer.d/override.conf;
                    sudo touch /etc/systemd/system/fstrim.timer.d/override.conf;
                    
                    (
                        echo "[Timer]"
                        echo "OnCalendar="
                        echo "OnCalendar=daily"
                    ) | sudo tee /etc/systemd/system/fstrim.timer.d/override.conf;
                    
                    sudo chmod 755 /etc/systemd/system/fstrim.timer.d/override.conf;
                    echo "Configuración de TRIM diario aplicada."
            fi
    fi
fi

#ACTUALIZACION SCRIPT ACTUALIZAR
if [ `egrep -c 'BOXABALAR' /usr/bin/actualizar` = '0' ] || [ `egrep -c '#ver20251121' /usr/bin/actualizar` = '0' ] || [ ! -f /usr/bin/actualizar ];
    then
        sudo rm -f /var/tmp/actuali*;
        sudo /usr/bin/wget -O /var/tmp/actualizar https://boxabalar.edu.xunta.gal/index.php/s/4Jjobka8t7J37g7/download/actualizar;
        sudo chmod 755 /var/tmp/actualizar;
        sudo mv -f /var/tmp/actualizar /usr/bin/actualizar;
        sudo rm -f /var/tmp/actuali*;
fi

#INSTALACIÓN DE NOVAS FONTES TIPOGRÁFICAS
#

#INSTALACIÓN NOS EQUIPOS CON PANEIS DIXITAIS A APLICACIÓN ONBOARD
if [ `egrep -c 'info2-profe' /etc/hostname` = '1' ] || [ `egrep -c 'aula' /etc/hostname` = '1' ] && [ `egrep -c 'portatil' /etc/hostname` = '0' ];
    then
        if [ ! -f /home/usuario/.config/autostart/onboard.desktop ];
            then
                sudo cp -f /usr/share/applications/onboard.desktop /home/usuario/.config/autostart/onboard.desktop;
        fi
        if [ ! -f /home/profesorado/.config/autostart/onboard.desktop ];
            then
                sudo cp -f /usr/share/applications/onboard.desktop /home/profesorado/.config/autostart/onboard.desktop;
        fi 
        if [ -d /home/sindo ];
            then
                if [ ! -f /home/sindo/.config/autostart/onboard.desktop ];
                    then
                        sudo cp -f /usr/share/applications/onboard.desktop /home/sindo/.config/autostart/onboard.desktop;
                fi
        fi   
        if [ -d /home/obdulia ];
            then
                if [ ! -f /home/obdulia/.config/autostart/onboard.desktop ];
                    then
                        sudo cp -f /usr/share/applications/onboard.desktop /home/obdulia/.config/autostart/onboard.desktop;
                fi
        fi   
fi


exit

#INSTALACIÓN DE MICROBLOCKS
#

