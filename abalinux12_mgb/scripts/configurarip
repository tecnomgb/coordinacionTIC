```bash
#!/bin/bash

# ============================================================
# CONFIGURACIÓN AUTOMÁTICA DE EQUIPOS - Debian 12 / KDE
#
# Busca la MAC del equipo en:
#
# /opt/github/abalinux12_mgb/ficheiros/inventario_equipos.csv
#
# Cuando encuentra la MAC:
#   EQUIPO  -> hostname
#   IP      -> dirección IP
#
# Red:
#   Máscara : /24 (255.255.255.0)
#   Gateway : 10.55.96.1
#
# Requiere:
#   Debian 12
#   NetworkManager
#   nmcli
# ============================================================

set -e

# ============================================================
# CONFIGURACIÓN
# ============================================================

CSV="/opt/github/abalinux12_mgb/ficheiros/inventario_equipos.csv"

GATEWAY="10.55.96.1"
PREFIX="24"

LOG="/var/log/configurar_equipo.log"

# ============================================================
# FUNCIONES
# ============================================================

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG"
}

error() {
    echo
    echo "============================================================"
    echo "ERROR"
    echo "============================================================"
    echo "$*"
    echo "============================================================"
    echo
    exit 1
}

# ------------------------------------------------------------
# Limpia un campo CSV
# ------------------------------------------------------------

limpiar_campo() {

    local CAMPO="$1"

    # Eliminar CR de Windows
    CAMPO="${CAMPO//$'\r'/}"

    # Eliminar espacios al principio y al final
    CAMPO="$(echo "$CAMPO" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

    # Eliminar comillas exteriores
    if [[ "$CAMPO" == \"*\" ]]; then
        CAMPO="${CAMPO#\"}"
        CAMPO="${CAMPO%\"}"
    fi

    echo "$CAMPO"
}

# ------------------------------------------------------------
# Normaliza una MAC
# ------------------------------------------------------------

normalizar_mac() {

    local MAC="$1"

    MAC="$(limpiar_campo "$MAC")"

    MAC="${MAC,,}"

    # Permitir MAC con guiones
    MAC="${MAC//-/:}"

    echo "$MAC"
}

# ------------------------------------------------------------
# Valida una MAC
# ------------------------------------------------------------

mac_valida() {

    local MAC="$1"

    [[ "$MAC" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]]
}

# ------------------------------------------------------------
# Valida una dirección IPv4
# ------------------------------------------------------------

ip_valida() {

    local IP="$1"

    if ! [[ "$IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        return 1
    fi

    IFS='.' read -r O1 O2 O3 O4 <<< "$IP"

    for OCTETO in "$O1" "$O2" "$O3" "$O4"; do

        if (( OCTETO < 0 || OCTETO > 255 )); then
            return 1
        fi

    done

    return 0
}

# ============================================================
# INICIO
# ============================================================

clear

echo
echo "============================================================"
echo " CONFIGURACIÓN AUTOMÁTICA DEL EQUIPO"
echo " Debian 12 / KDE / NetworkManager"
echo "============================================================"
echo

# ============================================================
# COMPROBAR ROOT
# ============================================================

if [ "$EUID" -ne 0 ]; then

    echo "ERROR: Este script debe ejecutarse como root."
    echo
    echo "Ejemplo:"
    echo
    echo "    sudo $0"
    echo

    exit 1

fi

# ============================================================
# PREPARAR LOG
# ============================================================

touch "$LOG" 2>/dev/null || true

log "============================================================"
log "Inicio de configuración"
log "============================================================"

# ============================================================
# COMPROBAR NETWORKMANAGER
# ============================================================

if ! command -v nmcli >/dev/null 2>&1; then

    error "No se encuentra nmcli.

NetworkManager no parece estar instalado.

Comprueba con:

    systemctl status NetworkManager"

fi

# ============================================================
# COMPROBAR QUE NETWORKMANAGER ESTÁ ACTIVO
# ============================================================

if ! systemctl is-active --quiet NetworkManager; then

    error "NetworkManager no está activo.

Comprueba con:

    systemctl status NetworkManager"

fi

# ============================================================
# COMPROBAR CSV
# ============================================================

if [ ! -f "$CSV" ]; then

    error "No se encuentra el archivo:

$CSV"

fi

if [ ! -r "$CSV" ]; then

    error "No se puede leer el archivo:

$CSV"

fi

log "Archivo CSV: $CSV"

# ============================================================
# COMPROBAR QUE EL CSV NO ESTÉ VACÍO
# ============================================================

if [ ! -s "$CSV" ]; then

    error "El archivo CSV está vacío:

$CSV"

fi

# ============================================================
# LEER CABECERA
# ============================================================

CABECERA=$(head -n 1 "$CSV")

if [ -z "$CABECERA" ]; then

    error "No se encuentra la cabecera del CSV."

fi

IFS=',' read -ra COLUMNAS <<< "$CABECERA"

COL_EQUIPO=-1
COL_MAC=-1
COL_IP=-1

for i in "${!COLUMNAS[@]}"; do

    CAMPO=$(limpiar_campo "${COLUMNAS[$i]}")

    case "${CAMPO^^}" in

        "EQUIPO")
            COL_EQUIPO=$i
            ;;

        "RED MAC")
            COL_MAC=$i
            ;;

        "IP")
            COL_IP=$i
            ;;

    esac

done

# ============================================================
# COMPROBAR COLUMNAS
# ============================================================

if [ "$COL_EQUIPO" -eq -1 ]; then
    error "El CSV no contiene la columna EQUIPO."
fi

if [ "$COL_MAC" -eq -1 ]; then
    error "El CSV no contiene la columna RED MAC."
fi

if [ "$COL_IP" -eq -1 ]; then
    error "El CSV no contiene la columna IP."
fi

log "Columnas CSV detectadas correctamente."

# ============================================================
# OBTENER INTERFACES DE RED
# ============================================================

declare -A MAC_INTERFACES

log "Buscando interfaces de red..."

for RUTA_INTERFAZ in /sys/class/net/*; do

    INTERFAZ=$(basename "$RUTA_INTERFAZ")

    # Ignorar loopback
    if [ "$INTERFAZ" = "lo" ]; then
        continue
    fi

    if [ ! -f "$RUTA_INTERFAZ/address" ]; then
        continue
    fi

    MAC=$(cat "$RUTA_INTERFAZ/address")

    MAC=$(normalizar_mac "$MAC")

    # Ignorar MAC vacía o cero
    if [ -z "$MAC" ] ||
       [ "$MAC" = "00:00:00:00:00:00" ]; then
        continue
    fi

    if mac_valida "$MAC"; then

        MAC_INTERFACES["$MAC"]="$INTERFAZ"

        log "Interfaz detectada: $INTERFAZ -> $MAC"

    fi

done

if [ "${#MAC_INTERFACES[@]}" -eq 0 ]; then

    error "No se han encontrado interfaces de red con una MAC válida."

fi

# ============================================================
# COMPROBAR MAC DUPLICADAS EN EL CSV
# ============================================================

declare -A MAC_CSV_VECES

while IFS=',' read -ra CAMPOS; do

    [ "${#CAMPOS[@]}" -eq 0 ] && continue

    MAC_CSV="${CAMPOS[$COL_MAC]}"

    MAC_CSV=$(normalizar_mac "$MAC_CSV")

    [ -z "$MAC_CSV" ] && continue

    MAC_CSV_VECES["$MAC_CSV"]=$(( ${MAC_CSV_VECES["$MAC_CSV"]:-0} + 1 ))

done < <(tail -n +2 "$CSV")

for MAC in "${!MAC_CSV_VECES[@]}"; do

    if [ "${MAC_CSV_VECES[$MAC]}" -gt 1 ]; then

        error "La MAC $MAC aparece más de una vez en el CSV.

Corrige el inventario antes de continuar."

    fi

done

# ============================================================
# COMPROBAR IP DUPLICADAS EN EL CSV
# ============================================================

declare -A IP_VECES

while IFS=',' read -ra CAMPOS; do

    [ "${#CAMPOS[@]}" -eq 0 ] && continue

    IP_CSV="${CAMPOS[$COL_IP]}"

    IP_CSV=$(limpiar_campo "$IP_CSV")

    [ -z "$IP_CSV" ] && continue

    IP_VECES["$IP_CSV"]=$(( ${IP_VECES["$IP_CSV"]:-0} + 1 ))

done < <(tail -n +2 "$CSV")

for IP_CHECK in "${!IP_VECES[@]}"; do

    if [ "${IP_VECES[$IP_CHECK]}" -gt 1 ]; then

        error "La IP $IP_CHECK aparece más de una vez en el CSV.

Corrige el inventario antes de continuar."

    fi

done

# ============================================================
# BUSCAR MAC DEL EQUIPO EN EL CSV
# ============================================================

EQUIPO=""
IP=""
INTERFAZ=""
MAC_ENCONTRADA=""

log "Buscando MAC del equipo en el inventario..."

while IFS=',' read -ra CAMPOS; do

    [ "${#CAMPOS[@]}" -eq 0 ] && continue

    MAC_CSV="${CAMPOS[$COL_MAC]}"
    EQUIPO_CSV="${CAMPOS[$COL_EQUIPO]}"
    IP_CSV="${CAMPOS[$COL_IP]}"

    MAC_CSV=$(normalizar_mac "$MAC_CSV")
    EQUIPO_CSV=$(limpiar_campo "$EQUIPO_CSV")
    IP_CSV=$(limpiar_campo "$IP_CSV")

    # Comprobar si esta MAC existe en el equipo
    if [ -n "${MAC_INTERFACES[$MAC_CSV]+x}" ]; then

        INTERFAZ="${MAC_INTERFACES[$MAC_CSV]}"
        MAC_ENCONTRADA="$MAC_CSV"
        EQUIPO="$EQUIPO_CSV"
        IP="$IP_CSV"

        break

    fi

done < <(tail -n +2 "$CSV")

# ============================================================
# SI NO SE ENCUENTRA LA MAC
# ============================================================

if [ -z "$EQUIPO" ]; then

    echo
    echo "============================================================"
    echo " EQUIPO NO ENCONTRADO EN EL INVENTARIO"
    echo "============================================================"
    echo
    echo "MAC encontradas en este ordenador:"
    echo

    for MAC in "${!MAC_INTERFACES[@]}"; do

        echo "    $MAC_INTERFACES[$MAC] -> $MAC"

    done

    echo
    echo "El equipo NO ha sido modificado."
    echo

    log "No se encontró ninguna MAC del equipo en el CSV."

    exit 1

fi

# ============================================================
# VALIDAR NOMBRE DE EQUIPO
# ============================================================

if [ -z "$EQUIPO" ]; then

    error "El campo EQUIPO está vacío para la MAC $MAC_ENCONTRADA."

fi

if [[ ! "$EQUIPO" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]]; then

    error "El nombre de equipo no es válido:

$EQUIPO

Utiliza únicamente letras, números, puntos y guiones."

fi

# ============================================================
# VALIDAR IP
# ============================================================

if [ -z "$IP" ]; then

    error "El campo IP está vacío para:

MAC: $MAC_ENCONTRADA
Equipo: $EQUIPO"

fi

if ! ip_valida "$IP"; then

    error "La IP '$IP' no es una dirección IPv4 válida."

fi

# ============================================================
# COMPROBAR QUE LA IP ESTÁ EN 10.55.96.0/24
# ============================================================

IFS='.' read -r IP1 IP2 IP3 IP4 <<< "$IP"

if [ "$IP1" -ne 10 ] ||
   [ "$IP2" -ne 55 ]
```

