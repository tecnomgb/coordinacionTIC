#ELIMINAR EXTENSIÓNS NON DESEXADAS NO CHROME
if [ $(egrep -c 'oldcee' /etc/opt/chrome/policies/managed/extensions.json) = '1' ];
    then
        sudo sed -i '/oldcee/d' /etc/opt/chrome/policies/managed/extensions.json;
fi

#PERSONALIZACIÓNS IES MILLADOIRO - IES MGB
#Detecta en que instituto se está executando o script
GATEWAY_IP=$(ip route | grep default | awk '{print $3}' | head -1);
if [ "$GATEWAY_IP" = '10.55.96.1' ]; then IES="MGB"; elif [ "$GATEWAY_IP" = '10.51.92.1' ] || [ "$GATEWAY_IP" = '10.41.109.1' ]; then IES="MILLADOIRO"; fi
#Personalización da páxina de inicio nos navegadores web
if [ "$IES" = "MGB" ];
    then
        if [ $(egrep -c 'iesmanuelgarciabarros' /usr/lib/firefox-esr/mozilla.cfg) != '1' ];
            then
                sudo sed -i '/browser.startup.homepage/d' /usr/lib/firefox-esr/mozilla.cfg;
                sudo sed -i '$a lockPref("browser.startup.homepage", "https://www.edu.xunta.gal/centros/iesmanuelgarciabarros/");' /usr/lib/firefox-esr/mozilla.cfg;
                sed -i '/^$/d' /usr/lib/firefox-esr/mozilla.cfg;
        fi
        if [ $(egrep -c 'iesmanuelgarciabarros' /etc/opt/chrome/policies/managed/m11_policies.json) != '2' ];
            then
                sudo sed -i '/HomepageLocation/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '/RestoreOnStartupURLs/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '/BrowserSignin/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '/}/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a "HomepageLocation": "https://www.edu.xunta.gal/centros/iesmanuelgarciabarros/" ,' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a "RestoreOnStartupURLs": ["https://www.edu.xunta.gal/centros/iesmanuelgarciabarros/"] ,' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a "BrowserSignin": 0 ' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a }' /etc/opt/chrome/policies/managed/m11_policies.json;
        fi
        if [ $(egrep -c '"RestoreOnStartupURLs": "https' /etc/opt/chrome/policies/managed/m11_policies.json) = '1' ];
            then
                sudo sed -i '/RestoreOnStartupURLs/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '/BrowserSignin/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '/}/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a "RestoreOnStartupURLs": ["https://www.edu.xunta.gal/centros/iesmanuelgarciabarros/"] ,' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a "BrowserSignin": 0 ' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a }' /etc/opt/chrome/policies/managed/m11_policies.json;
        fi                                
fi
if [ "$IES" = "MILLADOIRO" ];
    then
        sudo apt-get install -y scratux; 
        if [ $(egrep -c 'iesmilladoiro' /usr/lib/firefox-esr/mozilla.cfg) != '1' ];
            then
                sudo sed -i '/browser.startup.homepage/d' /usr/lib/firefox-esr/mozilla.cfg;
                sudo sed -i '$a lockPref("browser.startup.homepage", "https://www.edu.xunta.gal/centros/iesmilladoiro/");' /usr/lib/firefox-esr/mozilla.cfg;
                sed -i '/^$/d' /usr/lib/firefox-esr/mozilla.cfg;
        fi
        if [ $(egrep -c 'iesmilladoiro' /etc/opt/chrome/policies/managed/m11_policies.json) != '2' ];
            then
                sudo sed -i '/HomepageLocation/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '/RestoreOnStartupURLs/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '/BrowserSignin/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '/}/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a "HomepageLocation": "https://www.edu.xunta.gal/centros/iesmilladoiro/" ,' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a "RestoreOnStartupURLs": "https://www.edu.xunta.gal/centros/iesmilladoiro/" ,' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a "BrowserSignin": 0 ' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a }' /etc/opt/chrome/policies/managed/m11_policies.json;
        fi
        if [ $(egrep -c '"RestoreOnStartupURLs": "https' /etc/opt/chrome/policies/managed/m11_policies.json) = '1' ];
            then
                sudo sed -i '/RestoreOnStartupURLs/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '/BrowserSignin/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '/}/d' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a "RestoreOnStartupURLs": ["https://www.edu.xunta.gal/centros/iesmilladoiro/"] ,' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a "BrowserSignin": 0 ' /etc/opt/chrome/policies/managed/m11_policies.json;
                sudo sed -i '$a }' /etc/opt/chrome/policies/managed/m11_policies.json;
        fi
fi

#AUTOAPAGADO DOS EQUIPOS
if [ ! -f /etc/systemd/system/autoapagado.timer ] || [ `egrep -c '45' /etc/systemd/system/autoapagado.timer` = '0' ];
    then
        sudo rm -f /var/tmp/*.servic*;
        sudo rm -f /var/tmp/*.time*;
        sudo /usr/bin/wget -O /var/tmp/autoapagado.timer https://boxabalar.edu.xunta.gal/index.php/s/CFHESY5LqwCTzoE/download/autoapagado.timer;
        sudo /usr/bin/wget -O /var/tmp/autoapagado.service https://boxabalar.edu.xunta.gal/index.php/s/ZcrTnXz5snyRjE9/download/autoapagado.service;
        sudo mv -f /var/tmp/*.service /etc/systemd/system;
        sudo mv -f /var/tmp/*.timer /etc/systemd/system;
        sudo chmod 755 /etc/systemd/system/autoapagado*;
        sudo systemctl start autoapagado.timer;
        sudo systemctl enable autoapagado.timer;
        sudo systemctl daemon-reload;
fi

#ACTUALIZAR GIMP
if [ ! -f /var/lib/flatpak/app/org.gimp.GIMP/current/active/export/share/applications/org.gimp.GIMP.desktop ];
	then
	    sudo apt-get purge -y gimp;
		sudo apt-get install -y flatpak;
		sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo;
		sudo flatpak install --system -y https://flathub.org/repo/appstream/org.gimp.GIMP.flatpakref;
fi

if [ `egrep -c 'Manipulación' /var/lib/flatpak/app/org.gimp.GIMP/current/active/export/share/applications/org.gimp.GIMP.desktop` != '0' ];
	then
		sudo sed -i '/Name/d' /var/lib/flatpak/app/org.gimp.GIMP/current/active/export/share/applications/org.gimp.GIMP.desktop;
		sudo sed -i '$a Name=GIMP' /var/lib/flatpak/app/org.gimp.GIMP/current/active/export/share/applications/org.gimp.GIMP.desktop;
fi

#ACTUALIZAR INKSCAPE
