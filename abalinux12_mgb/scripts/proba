#!/bin/bash

# Verificar que se ejecuta como root (necesario para cambiar red y hostname)
if [ "$EUID" -ne 0 ]; then
  echo "[-] Este script debe ejecutarse con sudo o como root."
  exit 1
fi

# Ruta del archivo CSV
CSV_FILE="/opt/github/abalinux12_mgb/ficheiros/inventario_equipos.csv"

# Obtener la interfaz activa y su MAC
INTERFAZ=$(ip route get 8.8.8.8 | awk '{print $5; exit}')
if [ -z "$INTERFAZ" ]; then
    echo "[-] No se pudo detectar una interfaz de red activa."
    exit 1
fi

MAC_ACTUAL=$(cat /sys/class/net/$INTERFAZ/address)

IP_ENCONTRADA=""
EQUIPO_ENCONTRADO=""

# Leer el archivo CSV para buscar la MAC
while IFS=',' read -r aula equipo ip_csv marca modelo micro ranuras ram_cant ram_vel disco_dev disco_tam disco_tipo disco_part disco_arr red_int red_vel red_dup mac_csv || [ -n "$mac_csv" ]; do
    
    # Limpiar espacios, comillas y retornos de carro
    mac_csv=$(echo "$mac_csv" | tr -d '\r"' | xargs)
    ip_csv=$(echo "$ip_csv" | tr -d '\r"' | xargs)
    equipo=$(echo "$equipo" | tr -d '\r"' | xargs)
    
    # Saltar la cabecera
    [[ "$mac_csv" == "RED MAC" ]] && continue
    
    if [[ "${MAC_ACTUAL,,}" == "${mac_csv,,}" ]]; then
        IP_ENCONTRADA="$ip_csv"
        EQUIPO_ENCONTRADO="$equipo"
        break
    fi
done < <(tail -n +2 "$CSV_FILE")

if [[ -z "$IP_ENCONTRADA" ]]; then
    echo "[-] MAC ($MAC_ACTUAL) no encontrada en el inventario."
    exit 0
else
    echo "[+] MAC encontrada. Asignando equipo: $EQUIPO_ENCONTRADO con IP: $IP_ENCONTRADA"
    
    # 1. Asignar el nombre de equipo al sistema (Hostname)
    hostnamectl set-hostname "$EQUIPO_ENCONTRADO"
    
    # 2. Actualizar /etc/hosts
    if grep -q "127.0.1.1" /etc/hosts; then
        sed -i "s/127.0.1.1.*/127.0.1.1\t$EQUIPO_ENCONTRADO/" /etc/hosts
    else
        echo -e "127.0.1.1\t$EQUIPO_ENCONTRADO" >> /etc/hosts
    fi

    # 3. Gestionar la conexión de red evitando bloqueos
    NOMBRE_CONEXION="Conexion-Inventario-$INTERFAZ"
    
    echo "[+] Limpiando conexiones anteriores en la interfaz $INTERFAZ..."
    # Desactivar y borrar perfiles previos asociados a esta interfaz de forma silenciosa
    nmcli device disconnect "$INTERFAZ" 2>/dev/null
    nmcli -t -f NAME,DEVICE connection show | grep ":$INTERFAZ$" | cut -d: -f1 | while read -r c; do
        nmcli connection delete "$c" 2>/dev/null
    done

    echo "[+] Creando perfil de red gestionado para la interfaz $INTERFAZ..."
    # Crear la conexión y configurar IP, gateway y DNS en un solo comando para evitar múltiples bloqueos
    nmcli connection add type ethernet ifname "$INTERFAZ" con-name "$NOMBRE_CONEXION" \
        ipv4.addresses "$IP_ENCONTRADA/24" \
        ipv4.gateway "10.55.96.1" \
        ipv4.dns "8.8.8.8,1.1.1.1" \
        ipv4.method manual \
        autoconnect yes >/dev/null
        
    echo "[+] Aplicando la conexión sin bloqueo..."
    # Activar la conexión de manera asíncrona/forzada para que no se cuelgue la consola
    nmcli connection up "$NOMBRE_CONEXION" ifname "$INTERFAZ" >/dev/null 2>&1 &
    
    # Dar un pequeño respiro para que NetworkManager aplique el cambio de IP
    sleep 3
    
    echo "[✔] Configuración aplicada con éxito."
    echo "    - Hostname: $(hostname)"
    echo "    - IP asignada: $IP_ENCONTRADA en interfaz $INTERFAZ"
fi
