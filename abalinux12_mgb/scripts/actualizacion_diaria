#PAQUETES A DESINSTALAR
sudo apt-get purge -y anki evaoffline lepton-* aulaplaneta-offline dia ardora-abalar gcomprisqt-abalar s4a-abalar ventoy-abalar visualino-abalar ktuberling supertux crack-attack vokoscreen-ng gaupol freemind-abalar brltty;
