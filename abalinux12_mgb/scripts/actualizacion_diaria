#SCRIPT PARA A PREINSTALACIÓN DE EPOPTES NOS EQUIPOS DE ALUMNOS DE AULAS INFO
if [ `egrep -c 'info' /etc/hostname` = '1' ] && [ `egrep -c 'profe' /etc/hostname` = '0' ];
    then
        sudo apt-get install -y epoptes-client;
        #COMPROBACIÓN DE INFO1
        if [ `egrep -c 'info1' /etc/hostname` = '1' ];
            then
                ping -q -c2 10.55.96.100 > /dev/null;
                if [ $? -eq 0 ] && [ `egrep -c '10.55.96.100' /etc/hosts` = '0' ];
                    then
                        sudo sed -i '$a\10.55.96.100	server' /etc/hosts;
                        sudo epoptes-client -c;
                fi
		fi
		#COMPROBACIÓN DE INFO2
		if [ `egrep -c 'info2' /etc/hostname` = '1' ];
           then
               ping -q -c2 10.55.96.140 > /dev/null;
               if [ $? -eq 0 ] && [ `egrep -c '10.55.96.140' /etc/hosts` = '0' ];
                   then
                       sudo sed -i '$a\10.55.96.140	server' /etc/hosts;
                       sudo epoptes-client -c;
               fi
        fi
        #COMPROBACIÓN DE INFO3
		if [ `egrep -c 'info3' /etc/hostname` = '1' ];
           then
               ping -q -c2 10.55.96.180 > /dev/null;
               if [ $? -eq 0 ] && [ `egrep -c '10.55.96.180' /etc/hosts` = '0' ];
                   then
                       sudo sed -i '$a\10.55.96.180	server' /etc/hosts;
                       sudo epoptes-client -c;
               fi
		fi
	else
		if [ "$IES" = "MGB" ] && [ `egrep -c 'profe' /etc/hostname` = '0' ];
			then
				sudo apt-get purge -y epoptes-client;
		fi
fi

