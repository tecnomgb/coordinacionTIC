#ver20261001

#INSTALADOR DO SERVIZO DE ACTUALIZACIÓNS AUTOMÁTICAS DIARIAS
if [ ! -f /etc/systemd/system/actualizar.service ] || [ ! -f /etc/systemd/system/actualizar.timer ] || [ `egrep -c 'network-online' /etc/systemd/system/actualizar.service` = '0' ];
    then
        sudo rm -f /var/tmp/*.service;
        sudo rm -f /var/tmp/*.timer;
        sudo systemctl stop actualizar.service;
        sudo /usr/bin/wget -O /var/tmp/actualizar.service https://boxabalar.edu.xunta.gal/index.php/s/joJW9Jq3P89N9GH/download/actualizar.service;
        sudo /usr/bin/wget -O /var/tmp/actualizar.timer https://boxabalar.edu.xunta.gal/index.php/s/TeGgL5X5xmES79A/download/actualizar.timer;
        sudo mv -f /var/tmp/actualizar.service /etc/systemd/system/actualizar.service;
        sudo mv -f /var/tmp/actualizar.timer /etc/systemd/system/actualizar.timer;
		sudo chmod 755 /etc/systemd/system/actualiza*;
        sudo systemctl daemon-reload;
        sudo systemctl enable actualizar.timer;
        sudo systemctl start actualizar.timer;
        sudo systemctl start actualizar.service;
fi

#BLOQUEO DE PÁXINAS WEB
if [ `egrep -c 'info' /etc/hostname` = '1' ] && [ `egrep -c 'profe' /etc/hostname` = '0' ] || [ `egrep -c 'biblio' /etc/hostname` = '1' ] || [ `egrep -c 'portatil-tecno' /etc/hostname` = '1' ] || [ `egrep -c 'portatil-apoio' /etc/hostname` = '1' ];
    then
        ver_bloqueo="#ver20260726";
        if [ `egrep -c "$ver_bloqueo" /etc/hosts` = '0' ];
            then
                sudo sed '/#Inicio de listaxe de webs a bloquear/,/#Fin de listaxe de webs a bloquear/d' /etc/hosts;
                sudo /usr/bin/wget -O /var/tmp/listaxe_webs_bloqueadas https://boxabalar.edu.xunta.gal/index.php/s/zF53cwDZqgG229w/download/listaxe_webs_bloqueadas;
                sudo sed -i '$r /var/tmp/listaxe_webs_bloqueadas' /etc/hosts;
                sudo rm -f /var/tmp/listaxe_webs_bloqueadas;
        fi
fi

