sudo apt-get update;
#sudo apt-get install -y caja pluma caja-gtkhash caja-open-terminal caja-sendto caja-admin seahorse eom caja-actions mate-calc mate-utils-common engrampa eom efibootmgr grub-efi-amd64-bin grub-efi-amd64-signed grub-pc wine ktechlab grub-customizer logisim fonts-opensymbol fonts-roboto fonts-ubuntu gnome-chess simplescreenrecorder blender scribus cheese quadrapassel tmux ssh font-manager meshlab fstl;
