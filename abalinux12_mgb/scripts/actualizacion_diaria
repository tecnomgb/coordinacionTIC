#ACTUALIZAR PROCESSING
if [ -d /opt/processin* ];
    then
	    sudo sh /opt/processing-*/uninstall.sh;
	    sudo rm -rf /opt/processin*;
fi
if [ ! -f /var/lib/snapd/desktop/applications/processing_processing.desktop ];
    then
        sudo apt-get install snapd;
        sudo snap install processing --classic;
        sudo rm -f /usr/share/applications/processing_processing.desktop;
        sudo rm -f /usr/bin/processing;
        sudo ln -s /snap/bin/processing /usr/bin/processing;
        sudo cp -f /var/lib/snapd/desktop/applications/processing_processing.desktop /usr/share/applications;
fi
if [ $(egrep -c '/snap/processing/current/opt/processing/lib' /usr/share/applications/processing_processing.desktop) != '1' ];
	then
		sudo sed -i '/Icon/d' /usr/share/applications/processing_processing.desktop;
		sudo sed -i '$a Icon=/snap/processing/current/opt/processing/lib/Processing.png' /usr/share/applications/processing_processing.desktop;        
